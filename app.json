{
  "expo": {
    "name": "BillAdvocate",
    "slug": "bill-advocate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.billadvocate.patient"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.billadvocate.patient"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BillAdvocate to access your camera to photograph medical bills."
        }
      ]
    ]
  }
}
